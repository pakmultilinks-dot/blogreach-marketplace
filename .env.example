# Copy to .env and fill in. Never commit a real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./blogreach.db
# Set to "false" to skip demo seed data on startup
SEED_ON_STARTUP=true
# Email backend: "log" (default, stores emails in DB + prints to stdout) or "smtp"
EMAIL_BACKEND=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@blogreach.com
